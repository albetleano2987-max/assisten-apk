{
  "expo": {
    "name": "AI Floating Companion",
    "slug": "ai-floating-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.albetleano.aifloatingapp"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Aplikasi ini membutuhkan akses galeri untuk menganalisis tangkapan layar."
        }
      ]
    ]
  }
}
